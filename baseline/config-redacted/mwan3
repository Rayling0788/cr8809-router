
config globals 'globals'
	option mmx_mask '0x3F00'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option reliability '2'
	list track_ip '223.5.5.5'
	list track_ip '180.76.76.76'

config interface 'wan6'
	option enabled '0'
	list track_ip '2606:4700:4700::1001'
	list track_ip '2606:4700:4700::1111'
	list track_ip '2620:0:ccd::2'
	list track_ip '2620:0:ccc::2'
	option family 'ipv6'
	option reliability '2'

config policy 'wan_only'
	option use_member 'wan_m1_w1'

config rule 'https'
	option sticky '0'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'wan_priority'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'wan_priority'
	option family 'ipv4'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option use_policy 'balanced'
	option family 'ipv6'

config interface 'wwan2'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	list track_ip '10.40.72.1'

config interface 'wwan3'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	list track_ip '10.40.72.1'

config member 'wan_m1_w1'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'wwan2_m1_w1'
	option interface 'wwan2'
	option metric '1'
	option weight '1'

config member 'wwan3_m1_w1'
	option interface 'wwan3'
	option metric '1'
	option weight '1'

config policy 'balanced'
	list use_member 'wan_m1_w1'
	list use_member 'wwan2_m1_w1'
	list use_member 'wwan3_m1_w1'

config member 'wan_m3_w3'
	option interface 'wan'
	option metric '3'
	option weight '3'

config member 'wwan2_m3_w1'
	option interface 'wwan2'
	option metric '3'
	option weight '1'

config member 'wwan3_m3_w1'
	option interface 'wwan3'
	option metric '3'
	option weight '1'

config policy 'wan_priority'
	list use_member 'wan_m3_w3'
	list use_member 'wwan2_m3_w1'
	list use_member 'wwan3_m3_w1'

config member 'wwan2_m1_w2'
	option interface 'wwan2'
	option metric '1'
	option weight '2'

config member 'wwan3_m1_w2'
	option interface 'wwan3'
	option metric '1'
	option weight '2'

config policy 'wifi_priority'
	list use_member 'wan_m1_w1'
	list use_member 'wwan2_m1_w2'
	list use_member 'wwan3_m1_w2'

